// output: 4

extern func printf(fmt: str, ...) -> i32;

type Color = enum
    green,
    red,
    blue,
    yellow,
    pink,
    white,
    black,
    brown,
end

func main() -> Color
    const c: Color = Color.pink;
    if (c == Color.pink)
        _ = printf("Color is pink\n");
    end

    return c;
end
