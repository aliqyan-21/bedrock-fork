// output: 0

extern proc printf(...);

proc move_disks(count: i32, n1: i32, n3: i32, n2: i32)
  if (count > 0)
    move_disks(count - 1, n1, n2, n3);
    printf("Move %d from %d to %d.\n", count, n1, n3);
    move_disks(count - 1, n2, n3, n1);
  end
end

func main() -> i32
  move_disks(4, 1, 3, 2);
  return 0;
end
