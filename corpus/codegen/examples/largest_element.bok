// output: 76

func largest(list: []i32, lo: i32, hi: i32) -> i32
  var mx: i32 = undefined;

  if (lo == hi) return list[lo];
  else
    mx = largest(list, lo + 1, hi);

    if (mx >= list[lo]) return mx;
    else return list[lo]; end
  end
end

func main() -> i32
  var arr = [23, 43, 35, 38, 67, 12, 76, 10, 34, 8];
  var mx = largest(arr, 0, 9);
  return mx;
end
