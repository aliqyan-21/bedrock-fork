// output: 69

type P = struct
  x: i32,
  y: i32,

  func sum(self: *P) -> i32
    return self.x + self.y;
  end

  proc bump(self: *P)
    self.x = self.x + 1;
  end
end

type Q = struct
  p: P,
end

func main() -> i32
  var q = Q where p = P where x = 24, y = 44 end end
  q.p.bump();
  return q.p.sum();
end
