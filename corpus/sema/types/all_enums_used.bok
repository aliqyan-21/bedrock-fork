type Color = enum
  Red, Blue, Gold, Pink, Purple, Yellow
end

// this will not error as there is `else` used
proc foo()
  var c = Color.Blue;
  var b = 0;
  match c
    case Red
      b = 0;
    case Pink
      b = 1;
    case Gold
      b = 2;
    else
      b = -1;
  end
end

// this will error as all enum variants are not used
// as well as the `else` is not used.
proc bar()
  var c = Color.Blue;
  var b = 0;
  match c
    case Red
      b = 0;
    case Pink
      b = 1;
    case Gold
      b = 2;
  end
end
