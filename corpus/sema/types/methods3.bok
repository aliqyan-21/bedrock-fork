type P = struct
  x: i32,

  func bar(self: *P) -> i32
    return self.x;
  end

  func add(self: *P, n: i32) -> i32
    return self.x + n;
  end

  proc bump(self: *P)
    self.x = self.x + 1;
  end

  pub func make(a: i32) -> i32
    return a;
  end

  pub func sum(self: *P) ->i32
    return self.x + 10;
  end
end

proc main()
  var p = P where x = 5 end
  var pp = &p;
  var a = p.bar();      // auto &
  var b = pp.bar();     // already a pointer
  var c = p.sum();      // by value self
  var d = pp.sum();     // auto *
  p.bump();
  var f = P.bar(&p);    // explicit receiver
  var g = p.make(1);    // error: static method
end
